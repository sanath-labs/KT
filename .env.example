# =============================================================================
# KARAVALI-TRANSIT PRODUCTION & CLOUD ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# For Render, Supabase, Neon, or Railway, provide DATABASE_URL.
# When DATABASE_URL is set, the application automatically uses PostgreSQL
# and auto-initializes all tables, routes, and verified stops.
# Example: postgresql://postgres:password@ep-cool-db.us-east-2.aws.neon.tech/karavali_transit?sslmode=require
DATABASE_URL=

# Local PostgreSQL development fallback (used if DATABASE_URL is not set):
USE_POSTGRES=true
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=3136
PGDATABASE=karavali_transit

# -----------------------------------------------------------------------------
# 2. REAL OTP EMAIL DELIVERY (Gmail SMTP or Resend API)
# -----------------------------------------------------------------------------
# Option A: Gmail SMTP (Nodemailer)
# To generate a Gmail App Password:
# 1. Open Google Account (myaccount.google.com) -> Security
# 2. Enable 2-Step Verification
# 3. Search for "App passwords", create one named "Karavali Transit"
# 4. Paste the 16-character code below (no spaces needed)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Option B: Resend API (Recommended for Cloud - https://resend.com)
# If set, emails will be delivered via the modern Resend REST API
# RESEND_API_KEY=re_123456789
# RESEND_FROM=Karavali-Transit <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY
# -----------------------------------------------------------------------------
# Cryptographic salt for secure SHA-256 OTP hashing in the database
OTP_SECRET_SALT=karavali_transit_secure_otp_salt_v1

# -----------------------------------------------------------------------------
# 4. SUPABASE REALTIME (Optional - Frontend Live GPS Synchronization)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
